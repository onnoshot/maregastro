{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.maregastro.com"
        }
      ],
      "destination": "https://maregastro.com/:path*",
      "permanent": true
    },
    {
      "source": "/dijitalmenu/",
      "destination": "/dijitalmenu",
      "permanent": true
    },
    {
      "source": "/qr",
      "destination": "/qr/",
      "permanent": true
    },
    {
      "source": "/qr/en",
      "destination": "/qr/en/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/qr/",
      "destination": "/api/qr-page?lang=tr"
    },
    {
      "source": "/qr/en/",
      "destination": "/api/qr-page?lang=en"
    },
    {
      "source": "/dijitalmenu",
      "destination": "https://mare-gastro-dergi.vercel.app/dijitalmenu"
    },
    {
      "source": "/dijitalmenu/:path*",
      "destination": "https://mare-gastro-dergi.vercel.app/dijitalmenu/:path*"
    }
  ],
  "headers": [
    {
      "source": "/qr/app.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/qr-page.js": {
      "includeFiles": "qr/app.html"
    }
  }
}
