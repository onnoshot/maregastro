    {
      "source": "/menu/en/",
      "destination": "/api/qr-page?lang=en"
    },
    {
      "source": "/menu/ar/",
      "destination": "/api/qr-page?lang=ar"
    },
    {
      "source": "/menu/ru/",
      "destination": "/api/qr-page?lang=ru"
    }
  ],
  "headers": [
    {
      "source": "/menu/app.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/qr-page.js": {
      "includeFiles": "menu/app.html"
    }
  }
