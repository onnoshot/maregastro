{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.maregastro.com"
        }
      ],
      "destination": "https://maregastro.com/:path*",
      "permanent": true
    },
    {
      "source": "/dijitalmenu/",
      "destination": "/dijitalmenu",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/dijitalmenu",
      "destination": "https://mare-gastro-dergi.vercel.app/dijitalmenu"
    },
    {
      "source": "/dijitalmenu/:path*",
      "destination": "https://mare-gastro-dergi.vercel.app/dijitalmenu/:path*"
    }
  ]
}
